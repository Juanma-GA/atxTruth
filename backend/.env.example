# Infrastructure only. Functional settings live in Postgres (Settings → Configuration).
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://atxtruth:atxtruth_dev@localhost:5432/atxtruth
# Created by `npm run test:db:create`; must end in _test and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://atxtruth:atxtruth_dev@localhost:5432/atxtruth_test
AUTH_MODE=local
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_MINUTES=15
CORS_ORIGINS=http://localhost:5173
# Browsers accept Secure cookies on http://localhost; keep true everywhere else (HTTPS).
COOKIE_SECURE=true
LOG_LEVEL=INFO
